{
  "version": "1.2.10",
  "name": "subbly-builder-default",
  "private": true,
  "scripts": {
    "e2b:build:dev": "npx tsx build.dev.ts",
    "e2b:build:prod": "npx tsx build.prod.ts",
    "changelog": "pnpm changeset",
    "release": "pnpm changeset version",
    "daemon:manifest": "node daemon/manifest.mjs",
    "daemon:test": "node --test 'daemon/src/**/*.test.mjs'",
    "daemon:smoke": "node --env-file-if-exists=.env daemon/memory/run.mjs --minutes 10",
    "daemon:soak": "node --env-file-if-exists=.env daemon/memory/run.mjs --minutes 60"
  },
  "dependencies": {
    "@changesets/cli": "^2.31.0",
    "e2b": "^2.19.0"
  },
  "packageManager": "pnpm@12.5.1"
}
