[Unit]
Description=Subbly sandbox daemon
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=user
RuntimeDirectory=subbly
StateDirectory=subbly
WorkingDirectory=/opt/subbly/daemon/current
Environment=UV_THREADPOOL_SIZE=2
ExecStart=/usr/local/bin/node --lite-mode --max-old-space-size=48 --max-semi-space-size=1 --v8-pool-size=1 /opt/subbly/daemon/current/src/main.mjs
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=1
MemoryHigh=96M
MemoryMax=256M

[Install]
WantedBy=multi-user.target
